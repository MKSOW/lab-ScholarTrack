# ============================================================================
#  ScholarTrack — Variables d'environnement
#  Copier ce fichier en `.env` et remplir les valeurs réelles.
# ============================================================================

# Base de données PostgreSQL (Docker Compose, port 5434)
DATABASE_URL="postgresql://scholartrack:scholartrack_dev@localhost:5434/scholartrack?schema=public"

# Better Auth — générer un secret avec : openssl rand -base64 32
BETTER_AUTH_SECRET="<générer-un-secret-aléatoire>"
BETTER_AUTH_URL="http://localhost:3006"

# Port de l'API
PORT=3006

# ----------------------------------------------------------------------------
#  Compte administrateur (créé par le seed)
# ----------------------------------------------------------------------------
ADMIN_EMAIL="admin@scholartrack.local"
ADMIN_PASSWORD="<mot-de-passe-admin>"
ADMIN_NAME="Default Admin"

# ----------------------------------------------------------------------------
#  Comptes de test (créés par le seed) — 2 enseignants + 3 étudiants
#  Mot de passe partagé par tous les comptes non-admin.
# ----------------------------------------------------------------------------
SEED_PASSWORD="<mot-de-passe-comptes-de-test>"

TEACHER_1_EMAIL="prof.martin@scholartrack.local"
TEACHER_1_NAME="Prof Martin"
TEACHER_2_EMAIL="prof.durand@scholartrack.local"
TEACHER_2_NAME="Prof Durand"

STUDENT_1_EMAIL="etudiant1@scholartrack.local"
STUDENT_1_NAME="Alice Dupont"
STUDENT_2_EMAIL="etudiant2@scholartrack.local"
STUDENT_2_NAME="Bob Lefevre"
STUDENT_3_EMAIL="etudiant3@scholartrack.local"
STUDENT_3_NAME="Chloe Bernard"

# ----------------------------------------------------------------------------
#  Présences — seuil de déclenchement du flag "atRisk"
#  Valeur entre 0 et 1 : si taux de présence < seuil → étudiant à risque.
#  Convention scolaire fréquente : 0.75 (75%). Ajustable selon la politique.
# ----------------------------------------------------------------------------
ATTENDANCE_AT_RISK_THRESHOLD=0.75
